# ==========================================================================
# AI Data Analyst — backend environment
#
# Copy to backend/.env and fill in the blanks. NEVER commit backend/.env.
#
# Secrets, connection strings and account-specific values are left EMPTY.
# Tunables show their documented default from docs/PLAN.md §7 — app/config.py
# carries the same defaults, so you only need to set a tunable to override it.
# ==========================================================================

# ---- Database (Neon) ------------------------------------------------------
# Pooled string (host contains "-pooler"). Used by the RUNNING APP ONLY.
DATABASE_URL=

# Direct string (host does NOT contain "-pooler"). Used by ALEMBIC ONLY.
# Migrations through the pooler fail in partially-applied ways; app/config.py
# keeps these two separate on purpose and alembic/env.py never falls back.
DATABASE_URL_DIRECT=

# ---- Object storage (Neon Object Storage, S3-compatible, Beta) -----------
# The first four are what `neon env pull` injects. Endpoint pattern:
#   https://<branch_id>.storage.<region>.aws.neon.tech
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# NOT injected by Neon — set this by hand. The private bucket on the main
# branch that holds datasets/{dataset_id}.parquet.
# NOTE: it is "dataset", singular. Getting this wrong gives a bare 404 from
# HeadBucket with no hint that the name is the problem.
NEON_STORAGE_BUCKET=dataset

# ---- LLM provider (Google Gemini, free tier) -----------------------------
# Get a key at https://aistudio.google.com/apikey
#
# app/agent/llm.py passes this explicitly rather than letting the SDK look it
# up. The SDK checks GOOGLE_API_KEY first and GEMINI_API_KEY second, and there
# is a known failure when only GEMINI_API_KEY is set while Application Default
# Credentials are also present.
GEMINI_API_KEY=

# FALLBACK CHAINS, not single models — comma-separated, best first.
#
# The free tier's quota is 20 requests per DAY, PER MODEL, so a chain of three
# is three times the daily capacity. On a 429 the next model is tried
# immediately: a daily quota will not recover from a backoff of any length.
# All ids verified against list-models; verify again with
#   python scratch/check_model.py
#
# planner: must emit a tool plan that survives validators.py (core.py)
# NOT gemini-3.8-flash or 3.7-flash: real ids, but the free tier throttles
# them to minutes per token (measured 548s and 154s for ONE token).
# NOT gemini-3-flash-preview: exists in v1beta but not v1, and the client
# calls v1, so it would 404. gemini-3.5-flash is a valid third if wanted.
LLM_PLANNER_MODELS=gemini-3.6-flash,gemini-2.5-flash

# fast: explaining, condensing and summarising — cheap, frequent rewriting.
# -lite models carry a much larger daily allowance than flash models.
LLM_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Thinking is configured per MODEL, never per role. 0 disables it where that
# is allowed; leave blank to use each model's default.
#
# "Supports thinking" and "can have thinking turned off" are different, and
# the API only exposes the first: list-models reports thinking=True for every
# model above, yet gemini-3.5-flash-lite accepts a budget of 512 or -1 and
# REJECTS 0. llm.py handles that by retrying without the budget and
# remembering, so this value is safe to leave at 0.
LLM_THINKING_BUDGET=0

# Ask Gemini for raw JSON from the planner (response_mime_type). Together with
# the deterministic fence strip this is what gets a question down to ONE
# planner call: the planner used to wrap its reply in a ```json fence on
# attempt 1 of every question, failing json.loads and spending a second call.
LLM_PLANNER_JSON_MODE=true

LLM_STREAMING=true
LLM_TIMEOUT_SECONDS=60

# Rounds over the WHOLE chain after every model has refused. Within a round,
# a 429 moves to the next model without waiting.
LLM_MAX_RETRIES=2

# ---- Development response cache ------------------------------------------
# Caches LLM responses on disk, keyed by (model, full prompt), so a repeated
# prompt is free. With a 20/day quota, two verification runs exhaust a day,
# which otherwise makes iterating on anything downstream of the model
# disproportionately expensive.
#
# MUST BE OFF IN PRODUCTION, and app/config.py enforces that regardless of
# this value: a cached answer served to a real user looks perfectly fine and
# was computed for a different dataset.
#
# The directory holds raw prompts, which embed column names and the user's
# question, and is gitignored. Delete it to clear the cache.
LLM_DEV_CACHE=false
LLM_DEV_CACHE_DIR=.llm_cache

# FREE TIER, read this before using real data:
#   - Rate limited per minute and per day; a burst of questions will 429.
#   - Google may use prompts and responses from the free tier to improve their
#     products. Treat every upload as disclosed to Google.
#   - Demo with sample data only (samples/ in the repo). Do not upload
#     personal, confidential or client data.

# ---- Conversation memory (docs/PLAN.md §6) -------------------------------
# Kill switch: false disables question condensation. The app still works, it
# just stops understanding follow-ups. Useful if you hit a free-tier quota.
CONDENSER_ENABLED=true

# The window, counted in user+agent pairs (never half an exchange).
HISTORY_WINDOW_EXCHANGES=3

# Hard token backstop behind the window, for trim_messages.
HISTORY_TOKEN_BUDGET=3000

# Exchanges that must leave the window before the fact sheet is refreshed.
SUMMARY_REFRESH_EXCHANGES=2
SUMMARY_MAX_WORDS=150

# ---- Streaming (docs/PLAN.md §6B) ----------------------------------------
# Keep-alive comment interval, so an idle proxy does not close the SSE
# connection while the planner is thinking.
SSE_HEARTBEAT_SECONDS=15

# ---- Limits (docs/PLAN.md §11 Q4) ----------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_DATASET_ROWS=100000
MAX_DATASETS_PER_SESSION=20

# How many DataFrames to hold in memory at once.
DATAFRAME_CACHE_SIZE=3

# ---- HTTP ----------------------------------------------------------------
# Comma-separated, scheme included, no trailing slash. In production this is
# the deployed frontend origin; "*" will NOT work alongside credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Runtime -------------------------------------------------------------
# development | production. Gates /docs and tracebacks.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional error reporting.
SENTRY_DSN=

# ==========================================================================
# The frontend has its own env file (frontend/.env) with a single variable,
# VITE_API_BASE_URL. It is NOT set here: every VITE_-prefixed variable is
# compiled into the public bundle, so no secret may ever go behind that prefix.
# ==========================================================================
