# ==========================================================================
# AI Data Analyst — backend environment
#
# Copy to backend/.env and fill in the blanks. NEVER commit backend/.env.
#
# Secrets, connection strings and account-specific values are left EMPTY.
# Tunables show their documented default from docs/PLAN.md §7 — app/config.py
# carries the same defaults, so you only need to set a tunable to override it.
# ==========================================================================

# ---- Database (Neon) ------------------------------------------------------
# Pooled string (host contains "-pooler"). Used by the RUNNING APP ONLY.
DATABASE_URL=

# Direct string (host does NOT contain "-pooler"). Used by ALEMBIC ONLY.
# Migrations through the pooler fail in partially-applied ways; app/config.py
# keeps these two separate on purpose and alembic/env.py never falls back.
DATABASE_URL_DIRECT=

# ---- Object storage (Neon Object Storage, S3-compatible, Beta) -----------
# The first four are what `neon env pull` injects. Endpoint pattern:
#   https://<branch_id>.storage.<region>.aws.neon.tech
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# NOT injected by Neon — set this by hand. The private bucket on the main
# branch that holds datasets/{dataset_id}.parquet.
NEON_STORAGE_BUCKET=datasets

# ---- LLM provider --------------------------------------------------------
# Key for whatever LLM_BASE_URL points at.
LLM_API_KEY=

# Legacy name, still read as a fallback so an existing .env keeps working.
# Prefer LLM_API_KEY for anything new.
HUGGINGFACE_API_KEY=

LLM_BASE_URL=https://router.huggingface.co/v1
# Leave blank to use the default in app/config.py.
# The id must appear in the router's model list: the id this project
# originally hardcoded ("Qwen/Qwen3.8-Flash-Next:featherless-ai") is not a
# real model and always failed. Verify with: python scratch/check_model.py
LLM_MODEL=Qwen/Qwen3.8-Flash-Next-FP8
LLM_STREAMING=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- Conversation memory (docs/PLAN.md §6) -------------------------------
# Kill switch: false disables question condensation. The app still works, it
# just stops understanding follow-ups. Useful if you hit a free-tier quota.
CONDENSER_ENABLED=true

# The window, counted in user+agent pairs (never half an exchange).
HISTORY_WINDOW_EXCHANGES=3

# Hard token backstop behind the window, for trim_messages.
HISTORY_TOKEN_BUDGET=3000

# Exchanges that must leave the window before the fact sheet is refreshed.
SUMMARY_REFRESH_EXCHANGES=2
SUMMARY_MAX_WORDS=150

# ---- Streaming (docs/PLAN.md §6B) ----------------------------------------
# Keep-alive comment interval, so an idle proxy does not close the SSE
# connection while the planner is thinking.
SSE_HEARTBEAT_SECONDS=15

# ---- Limits (docs/PLAN.md §11 Q4) ----------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_DATASET_ROWS=100000
MAX_DATASETS_PER_SESSION=20

# How many DataFrames to hold in memory at once.
DATAFRAME_CACHE_SIZE=3

# ---- HTTP ----------------------------------------------------------------
# Comma-separated, scheme included, no trailing slash. In production this is
# the deployed frontend origin; "*" will NOT work alongside credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Runtime -------------------------------------------------------------
# development | production. Gates /docs and tracebacks.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional error reporting.
SENTRY_DSN=

# ==========================================================================
# The frontend has its own env file (frontend/.env) with a single variable,
# VITE_API_BASE_URL. It is NOT set here: every VITE_-prefixed variable is
# compiled into the public bundle, so no secret may ever go behind that prefix.
# ==========================================================================
