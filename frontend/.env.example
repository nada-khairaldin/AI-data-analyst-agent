# The backend origin. No trailing slash.
#
# Must be VITE_-prefixed or Vite will not expose it to the bundle — and every
# VITE_ variable is compiled into the PUBLIC bundle, so never put a secret
# behind that prefix.
#
# Local backend:  http://127.0.0.1:8100
VITE_API_BASE_URL=https://ai-data-analyst-h1rx.onrender.com
